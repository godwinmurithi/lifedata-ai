# LifeData AI orchestrator — sandbox.lifehealth.app.
#
# Copy to `.env` beside docker-compose.yml and fill in the three secrets.
# `.env` is git-ignored; this file is the documented shape.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=lifedata.settings

# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Action envelopes are signed with the secret key above, so DEBUG stays off and
# the key must be real. settings.py refuses to boot on the development default
# with DEBUG off, which is the intended behaviour, not an obstacle.
DJANGO_DEBUG=false

# nginx forwards `Host: sandbox.lifehealth.app`.
DJANGO_ALLOWED_HOSTS=sandbox.lifehealth.app,localhost,127.0.0.1

# nginx terminates TLS. Without this Django computes its own origin as http://
# while the browser sends https://, and the middleware's cross-origin check
# refuses every chat turn. See the note in settings.py.
DJANGO_TRUST_PROXY_PROTO=true

# --- Database -------------------------------------------------------------
# The EXISTING staging Postgres. No new database: the orchestrator's tables go
# into a `lifedata_ai` schema alongside Superset's own `superset` schema.
#
# The role is deliberately NOT superset_app. The orchestrator never writes to
# Superset — the user's browser does — and a role able to rewrite
# superset.dashboards directly would dissolve that property silently.
POSTGRES_HOST=db-staging4cti
POSTGRES_PORT=5432
POSTGRES_DB=cti_geonode_data
POSTGRES_USER=lifedata_ai
POSTGRES_PASSWORD=
DJANGO_DB_SCHEMA=lifedata_ai

# Our models declare no geometry columns — the spatial work lives in the
# datasets Superset already reads — so the plain backend is correct and GDAL is
# never loaded.
DJANGO_DB_ENGINE=django.db.backends.postgresql

# --- Superset -------------------------------------------------------------
# Container-to-container, on cti_geonode_default. Server-side read tools call
# this URL forwarding the end user's own session cookie.
LIFEDATA_AI_SUPERSET_INTERNAL_URL=http://superset-staging4cti:8088

# Belt and braces beside DJANGO_TRUST_PROXY_PROTO: the browser's Origin on every
# state-changing request.
LIFEDATA_AI_ALLOWED_ORIGINS=https://sandbox.lifehealth.app

# --- Model ----------------------------------------------------------------
ANTHROPIC_API_KEY=
LIFEDATA_AI_PROVIDER=anthropic
# For OpenAI: set provider=openai, OPENAI_API_KEY, and model=gpt-5.3-codex.
OPENAI_API_KEY=
# For DeepSeek: set provider=deepseek, DEEPSEEK_API_KEY, and model=deepseek-flash.
DEEPSEEK_API_KEY=
LIFEDATA_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
LIFEDATA_AI_MODEL=claude-opus-5

# `medium`, not `high` — measured, not a cost choice. With tools attached, high
# returned overloaded_error on essentially every request. See settings.py.
LIFEDATA_AI_EFFORT=medium
LIFEDATA_AI_MAX_TOOL_ROUNDS=12
LIFEDATA_AI_TURN_TIMEOUT_SECONDS=300
# See .env for what this needs and why.
LIFEDATA_AI_QUERY_LOG_DB_URL=postgresql://user:password@db-staging4cti:5432/cti_geonode_data?options=-csearch_path%3Dsuperset,public

# Authenticated dashboard browser inspection, using the shared application origin.
LIFEDATA_AI_BROWSER_BASE_URL=https://sandbox.lifehealth.app
LIFEDATA_AI_QUALITY_REPAIR_LIMIT=2
