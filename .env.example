# LifeData AI Copilot — environment template.
# Copy to `.env` and fill in. NEVER commit a real `.env` (it is git-ignored).
#
# `deploy/docker-compose.yml` and the Django orchestrator both read this file.

# --- Anthropic ------------------------------------------------------------
# Required for the live agent loop. Without it the orchestrator starts but
# returns a clear error on /api/chat/ instead of contacting the model.
ANTHROPIC_API_KEY=

# Model powering the agent loop. Verified against the current model catalogue.
LIFEDATA_AI_MODEL=claude-opus-5
# Reasoning depth for the loop: low | medium | high | xhigh | max
#
# `medium` is a measured choice, not a cost one. Bisected: 13 tools + `high`
# returned overloaded_error on essentially every request; 25 tools + `medium` at
# 32k succeeded. A dashboard build needs several consecutive rounds, so one
# overload anywhere in the chain aborted the whole thing. See docs/runbook.md “Anthropic capacity”.
LIFEDATA_AI_EFFORT=medium
# Hard stop on tool-use rounds within a single turn (spec §5).
LIFEDATA_AI_MAX_TOOL_ROUNDS=12
# Proposed changes per TURN. A dashboard is ~9 write actions without layout
# recipes, so this leaves headroom. A previewed build spans two turns, so this
# bounds a turn rather than a dashboard.
LIFEDATA_AI_MAX_WRITES_PER_TURN=14
# Wall-clock bound on MODEL work. Time spent awaiting the browser is measured and
# added back, so turn timeouts do not track network quality.
LIFEDATA_AI_TURN_TIMEOUT_SECONDS=300

# --- Superset -------------------------------------------------------------
# Superset REFUSES TO START with a weak key. Generate one with:
#   openssl rand -base64 42
SUPERSET_SECRET_KEY=

# Internal URL the orchestrator uses for server-side read tools (spec §2).
# Container-to-container it is http://superset:8088; from the host, use the
# nginx entry point so everything stays same-origin.
LIFEDATA_AI_SUPERSET_INTERNAL_URL=http://localhost:8080

# --- Native MCP (superset_mcp_client.py) -----------------------------------
# Superset's own MCP service (superset/mcp_service/, 6.1.0+), reached
# container-to-container -- never publish this port on the host.
LIFEDATA_AI_MCP_URL=http://superset:5008/mcp/
# Shared HS256 secret with Superset's MCP_JWT_SECRET (superset_config.py).
# Generate with: openssl rand -base64 42
MCP_JWT_SECRET=
# Read tools use native MCP when true, the original REST client when false --
# see tools/base.py ToolContext.use_mcp_reads. No redeploy needed to flip.
LIFEDATA_AI_USE_MCP_READS=true

# Demo accounts created by deploy/superset/bootstrap.sh.
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=
SUPERSET_ANALYST_USERNAME=analyst
SUPERSET_ANALYST_PASSWORD=

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=lifedata
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=lifedata

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
